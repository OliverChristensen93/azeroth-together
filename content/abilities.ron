// Abilities, ported from benilla-app's survivors/data.rs. `visual` is the Spell.dbc id whose
// cast, missile and impact the client shows.
// kind: Bolt (missile at the nearest `count` enemies in `range`, `radius` splash),
//       Strike (instant hit on the nearest `count` in `range`),
//       Nova (everything within `radius` of the caster).
// `missile_speed` is the spell's own projectile speed in Spell.dbc (yards/second); 0 is instant.
// Ground areas are approximated as a Nova around the caster at three ticks' damage; damage over
// time is folded into one Strike; totems cast their own spell on their own beat.
// Not yet supported by the simulation (left out here and from every class pool):
//   retaliation, power_word_shield, divine_shield, thorns, rejuvenation.
[
    // --- Mage ---
    (key: "frostbolt", name: "Frostbolt", visual: 116, kind: Bolt,
     damage: 12.0, cooldown: 1.3, range: 24.0, missile_speed: 28.0, target: Some(ElitesFirst),
     tags: [Frost, Projectile, Direct, Slow],
     description: "Hurls a bolt of frost at the nearest elite or boss, else the nearest enemy. Chills."),
    (key: "fireball", name: "Fireball", visual: 133, kind: Bolt,
     damage: 20.0, cooldown: 2.4, range: 26.0, radius: 3.5, missile_speed: 24.0,
     target: Some(ElitesFirst), tags: [Fire, Projectile, Direct, Area],
     description: "Lobs a ball of fire at the nearest elite or boss; it bursts over the enemies around it."),
    (key: "arcane_missiles", name: "Arcane Missiles", visual: 7268, kind: Bolt,
     damage: 6.0, cooldown: 1.9, range: 22.0, volley: 3, missile_speed: 20.0,
     target: Some(ElitesFirst), tags: [Arcane, Projectile, Direct],
     description: "Looses three arcane missiles at the nearest elite or boss, else the nearest enemy."),
    (key: "frost_nova", name: "Frost Nova", visual: 122, kind: Nova,
     damage: 8.0, cooldown: 7.0, radius: 9.0, freeze: 2.0, tags: [Frost, Area, Direct, Freeze],
     description: "Blasts every enemy around you with a ring of frost that Freezes them."),
    (key: "arcane_explosion", name: "Arcane Explosion", visual: 1449, kind: Nova,
     damage: 10.0, cooldown: 2.8, radius: 7.0, tags: [Arcane, Area, Direct],
     description: "A burst of arcane energy hits everything close to you."),
    (key: "blizzard", name: "Blizzard", visual: 10, kind: Ground,
     damage: 6.0, cooldown: 9.0, range: 20.0, radius: 7.0, duration: 6.0,
     tags: [Frost, Ground, Area, DamageOverTime, Slow],
     description: "Ice falls on the thickest crowd within 20 yards for 6 seconds, Chilling all inside."),
    (key: "flamestrike", name: "Flamestrike", visual: 2120, kind: Nova,
     damage: 42.0, cooldown: 8.0, radius: 5.0, leaves_ground: 4.0,
     tags: [Fire, Ground, Area, DamageOverTime],
     description: "A pillar of flame scorches every enemy near you and leaves the ground burning."),
    (key: "fire_blast", name: "Fire Blast", visual: 2136, kind: Strike,
     damage: 26.0, cooldown: 3.5, range: 12.0, tags: [Fire, Direct],
     description: "Instantly blasts the enemy closest to you with fire."),
    (key: "cone_of_cold", name: "Cone of Cold", visual: 120, kind: Nova,
     damage: 14.0, cooldown: 4.5, radius: 11.0, target: Some(Ahead),
     tags: [Frost, Area, Direct, Slow],
     description: "A wide sweep of cold hits every enemy ahead of you and Chills them."),
    (key: "blast_wave", name: "Blast Wave", visual: 11113, kind: Nova,
     damage: 18.0, cooldown: 6.5, radius: 8.0, tags: [Fire, Area, Direct, Slow, Knockback],
     description: "A wave of fire erupts around you, knocking enemies back and Chilling them."),
    (key: "pyroblast", name: "Pyroblast", visual: 11366, kind: Bolt,
     damage: 70.0, cooldown: 6.0, range: 30.0, missile_speed: 24.0, burn: 0.3,
