// The run's limits. A game mode can ship its own copy; anything it leaves out keeps the default
// shown here.
(
    // Different tomes a hero can hold; once full, level-ups and shrines only raise those.
    tome_slots: 4,
    // The rank a tome stops at. Rarity still sets how much each pick adds.
    tome_max_rank: 5,
    // The most copies of one item. Items with a chance stop where their chance tops out.
    item_max_copies: 5,
    // Seconds between chances of a new shrine, while fewer than the zone's `shrines_at_once` stand.
    shrine_every: 90.0,
    // Seconds after a camp's elite dies before a new one guards the camp again.
    elite_respawn: 180.0,
    // Every enemy's speed from enemies.ron is multiplied by this, but held to at most
    // `enemy_speed_cap` yards a second (heroes run 7), so the horde keeps up without pinning a
    // hero who keeps moving. 1.0 and a cap of 99 give the old, slower horde.
    enemy_speed: 1.35,
    enemy_speed_cap: 6.65,
    // The horde comes from behind the way a hero runs, never straight ahead. Halfway to each
    // boss a swarm sends it from every side, for `surround_secs`.
    surround_secs: 12.0,
    // Health in ordinary enemies. A rare (a camp's guard) has `rare_health` of the kind two tiers
    // above the horde; an elite (now and then in the horde, and a Challenge Idol's)
    // `elite_health` of its own kind's; a boss `boss_health` of the horde's strongest kind at
    // the time, and the run's last boss (the `final_boss`th) `final_boss_health`.
    rare_health: 30.0,
    elite_health: 15.0,
    boss_health: 50.0,
    final_boss_health: 75.0,
    final_boss: 3,
)
