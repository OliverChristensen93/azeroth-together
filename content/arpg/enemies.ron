// Enemies. `display` is the CreatureDisplayInfo id. Every blow is telegraphed: `windup` seconds of
// warning, then it lands on whoever is still in it. behaviour: Melee swings in an arc `reach`
// long; Slam hits a circle of `reach` around itself; Ranged keeps to `reach` and throws a missile
// (`missile_speed`, `missile_visual` a Spell.dbc id, `missile_school`) along a marked line. `tough` halves freezes.
// As in WoW they stand at home until a hero comes within `aggro` yards (or hits them, which
// brings any idle neighbour too), and give up past `leash` yards from home, running back whole.
[
    // --- Northshire Valley ---
    (key: "young_wolf", name: "Young Wolf", display: 447, level: 1, hp: 40.0, speed: 6.5,
     radius: 0.8, damage: 7.0, behaviour: Melee, reach: 2.0, windup: 0.5, recover: 0.8),
    (key: "kobold_vermin", name: "Kobold Vermin", display: 139, scale: 0.85, level: 2, hp: 50.0,
     speed: 5.0, damage: 8.0, behaviour: Melee, reach: 2.0, windup: 0.55, recover: 0.8),
    (key: "kobold_worker", name: "Kobold Worker", display: 373, scale: 0.95, level: 3, hp: 70.0,
     speed: 5.0, damage: 10.0, behaviour: Melee, reach: 2.2, windup: 0.6, recover: 0.9),
    (key: "kobold_laborer", name: "Kobold Laborer", display: 373, scale: 1.15, level: 4, radius: 0.9,
     hp: 140.0, speed: 4.5, damage: 20.0, behaviour: Slam, reach: 3.5, windup: 1.1, recover: 1.3),
    (key: "defias_thug", name: "Defias Thug", display: 5035, scale: 1.15, level: 4, hp: 90.0,
     speed: 5.5, damage: 12.0, behaviour: Melee, reach: 2.4, windup: 0.6, recover: 0.9),
    // Casters among the vineyards' thugs. Their missiles fly at the spell's own Spell.dbc speed
    // (Frostbolt 28, Fireball 24), so WoW's drawn bolt keeps step with the real one.
    (key: "defias_rogue_wizard", name: "Defias Rogue Wizard", display: 2359, scale: 1.1, level: 4,
     aggro: 14.0, hp: 55.0, speed: 4.5, damage: 14.0, behaviour: Ranged, reach: 18.0, windup: 1.0,
