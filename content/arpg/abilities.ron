// Azeroth ARPG's abilities. Every one is aimed at the ground point under the cursor; none needs
// a target and none casts by itself. `visual` is the Spell.dbc id whose cast, missile and impact
// the client shows (and whose icon goes on the bar).
// shape: Projectile(speed, radius, pierce, count, spread (degrees), splash) flies to `range`;
//        Ground(radius, delay, duration, tick, tick_damage) lands at the cursor, pulled in to `range`;
//        Cone(angle) reaches `range`; Nova(radius) is around the caster;
//        Guard(duration, immune, absorb) is on the caster; Blink jumps toward the cursor, up to `range`.
// `channel` seconds: the shape goes off every `channel_tick` while the key is held and the caster
// stands still (a Ground shape lasts that long instead). `cast_time` roots the caster unless
// `move_while_casting`. effects: chill/freeze seconds, burn (damage) over burn_secs, knockback yards.
// A hit on a Frozen enemy is always a critical strike (Shatter).
[
    // --- Mage ---
    (key: "frostbolt", name: "Frostbolt", visual: 116, school: Frost,
     shape: Projectile(speed: 30.0, radius: 0.6),
     damage: 30.0, mana: 4.0, cast_time: 0.35, range: 32.0,
     effects: (chill: 3.0),
     description: "Launches a bolt of frost where you aim for {damage} Frost damage, Chilling the first enemy it hits."),
    (key: "fireball", name: "Fireball", visual: 133, school: Fire,
     shape: Projectile(speed: 24.0, radius: 0.8, splash: 3.0),
     damage: 55.0, mana: 12.0, cast_time: 0.8, range: 32.0,
     effects: (burn: 16.0, burn_secs: 4.0),
     description: "Hurls a fiery ball for {damage} Fire damage that splashes nearby enemies and burns its target."),
    (key: "arcane_missiles", name: "Arcane Missiles", visual: 7268, school: Arcane,
     shape: Projectile(speed: 34.0, radius: 0.5),
     damage: 14.0, mana: 18.0, cooldown: 1.0, channel: 2.5, channel_tick: 0.42, range: 30.0,
     description: "Channel a stream of arcane missiles toward the cursor, {damage} Arcane damage each."),
    (key: "frost_nova", name: "Frost Nova", visual: 122, school: Frost,
     shape: Nova(radius: 8.0),
     damage: 12.0, mana: 15.0, cooldown: 12.0,
     effects: (freeze: 4.0),
     description: "Blasts enemies around you for {damage} Frost damage and Freezes them in place."),
    (key: "blizzard", name: "Blizzard", visual: 10, school: Frost,
     shape: Ground(radius: 6.0, tick: 1.0, tick_damage: 20.0),
     mana: 30.0, cooldown: 8.0, channel: 6.0, range: 30.0,
     effects: (chill: 2.0),
     description: "Channel ice shards onto the area under the cursor, {tick_damage} Frost damage a second and Chilling everything inside."),
    (key: "flamestrike", name: "Flamestrike", visual: 2120, school: Fire,
     shape: Ground(radius: 4.5, delay: 0.75, duration: 4.0, tick: 1.0, tick_damage: 10.0),
     damage: 60.0, mana: 25.0, cooldown: 6.0, cast_time: 0.5, range: 30.0,
     description: "Calls down a pillar of fire at the cursor for {damage} Fire damage, leaving the ground burning."),
    (key: "cone_of_cold", name: "Cone of Cold", visual: 120, school: Frost,
     shape: Cone(angle: 70.0),
     damage: 35.0, mana: 18.0, cooldown: 6.0, range: 10.0,
     effects: (chill: 4.0),
     description: "Blasts a cone of frost toward the cursor for {damage} Frost damage, Chilling everything in it."),
    (key: "dragons_breath", name: "Dragon's Breath", visual: 2136, school: Fire, // TBC spell: 1.12 has no Dragon's Breath, so Fire Blast's look
     shape: Cone(angle: 70.0),
     damage: 45.0, mana: 20.0, cooldown: 14.0, range: 9.0,
     effects: (freeze: 2.5, knockback: 2.0),
     description: "Breathes fire toward the cursor for {damage} Fire damage, leaving enemies dazed."),
    (key: "ice_block", name: "Ice Block", visual: 11958, school: Frost,
     shape: Guard(duration: 4.0, immune: true),
     cooldown: 40.0,
     description: "Encases you in ice: nothing can touch you, and you can do nothing, for 4 sec."),
    (key: "mana_shield", name: "Mana Shield", visual: 1463, school: Arcane,
     shape: Guard(duration: 30.0, absorb: 80.0),
     mana: 30.0, cooldown: 20.0,
     description: "Absorbs the next 80 damage you take."),
    (key: "blink", name: "Blink", visual: 1953, school: Arcane,
     shape: Blink,
     mana: 8.0, cooldown: 5.0, range: 12.0,
     description: "Teleports you toward the cursor, up to {range} yards."),
]
