// Zones. `start` is where heroes begin, and where they wake after falling, in WoW coordinates
// (x, y, z); `map` the Map.dbc id. `camps` stand where WoW's would: `count` of `enemy` within
// `spread` yards of `at`, each back `respawn` seconds after it dies. Placed by hand from the
// terrain (`together-port spot`), not from WoW's spawn tables, which the game data has none of.
[
    (key: "northshire", name: "Northshire Valley", map: 0, start: (-8949.95, -132.49, 83.5),
     camps: [
        // Young wolves on the slopes east of the Abbey.
        (enemy: "young_wolf", at: (-8905.0, -55.0), count: 2),
        (enemy: "young_wolf", at: (-8870.0, -10.0), count: 3),
        (enemy: "young_wolf", at: (-8960.0, 10.0), count: 2),
        (enemy: "young_wolf", at: (-8820.0, 40.0), count: 2),
        // Kobold vermin in the fields north, toward the mine.
        (enemy: "kobold_vermin", at: (-8830.0, -160.0), count: 3),
        (enemy: "kobold_vermin", at: (-8780.0, -70.0), count: 3),
        (enemy: "kobold_vermin", at: (-8850.0, -250.0), count: 2),
        // Echo Ridge Mine's mouth.
        (enemy: "kobold_worker", at: (-8710.0, -160.0), count: 3),
        (enemy: "kobold_worker", at: (-8690.0, -70.0), count: 3),
        (enemy: "kobold_laborer", at: (-8688.0, -118.0), count: 2, spread: 3.0, respawn: 90.0),
        // Northshire Vineyards, across the river.
        (enemy: "defias_thug", at: (-9060.0, -340.0), count: 2),
        (enemy: "defias_thug", at: (-9085.0, -390.0), count: 3),
        (enemy: "defias_thug", at: (-9120.0, -450.0), count: 3),
        (enemy: "garrick_padfoot", at: (-9140.0, -405.0), respawn: 300.0),
     ]),
]
