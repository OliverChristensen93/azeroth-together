    // --- Bosses: one per zone (zones.ron `boss`), every four minutes. Each wears a model already
    // drawn in its zone, grown; their health is grown again for every hero in the party. ---
    (key: "hogger", mechanics: [Charge, Slam, Spores],
     hint: "Charges along a marked line, then slams the ground: step aside, then out of the circle. Green spores give crit: walk into them.",
     name: "Hogger", display: 384, level: 11, scale: 1.9, radius: 1.3,
     hp: 4000.0, speed: 4.4, damage: 45.0, xp: 40),
    (key: "sergeant_brashclaw", mechanics: [Charge, Patches, Bomb],
