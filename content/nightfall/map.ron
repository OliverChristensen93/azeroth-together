// Duskwood at night. `map` is the Map.dbc id (0, the Eastern Kingdoms). `bounds` is the run's edge
// in WoW yards (x north, y west): for now a rectangle around the zone, traced along its real edge
// in sub-project 2. `entries` are where a party starts, (x, y, z); the first is the zone centre the
// survivors content already plays in. More entries (the north bridge, the west and east roads) go
// here once measured in the game with NIGHTFALL_TRACE_POS=1.
(
    key: "duskwood",
    name: "Duskwood",
    map: 0,
    bounds: [
        (-9880.0, 800.0),
        (-9880.0, -1850.0),
        (-11500.0, -1850.0),
        (-11500.0, 800.0),
    ],
    entries: [
        (-10051.8, -792.5, 36.5),
    ],
    // Lit places, (x, y, radius) yards: a hero standing in one is easier to see. measure:
    // Darkshire's lamps and the campfires, once walked in the game (NIGHTFALL_TRACE_POS=1).
    lit: [],
    // The ways out (spec §8.1): stand `extract_for` seconds in a ring of `radius` yards (4 when
    // left out). `late` opens at rules.ron's `cart_opens_at`. measure: every exit, in the game.
    // The Deadwind road is placed on the baked valley floor 20 yards inside the east edge (flat,
    // 4 and 10 yard rings walkable); the other three were checked walkable in the bake too.
    exits: [
        (key: "bridge", name: "The bridge to Elwynn", at: (-9930.0, -480.0)),
        (key: "westfall_road", name: "The Westfall road", at: (-10650.0, 760.0)),
        (key: "deadwind_road", name: "The Deadwind road", at: (-10570.0, -1830.0)),
        (key: "darkshire_cart", name: "The Night Watch cart", at: (-10560.0, -1150.0), late: true),
    ],
)
