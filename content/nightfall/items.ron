     look: Some(Outfit(class_id: 5))),
    (key: "scavengers_leggings", name: "Scavenger's Leggings", kind: Armour,
     icon: "INV_Pants_Leather_09", quality: 1, weight: 3.0, value: 20, slot: Some(Legs),
