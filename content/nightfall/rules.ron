// Nightfall's rules. Sub-project 1 has the atmosphere (spec §10, §11); later sub-projects add their
// own settings here.
(
    // Every hero's level, matching Duskwood's creatures.
    hero_level: 30,
    atmosphere: (
        // Midnight.
        night_minute: 0,
        // Yards; the colour is sRGB 0..1, a dark blue-green.
        fog_start: 10.0,
        fog_end: 40.0,
        fog_color: (0.04, 0.07, 0.08),
        // How far the world is drawn, yards: past the fog, short of the stock 350.
        view_distance: 120.0,
        // A warm glow at each hero, linear RGB: a pool of light around the hero's feet, not a beacon.
        hero_light: (color: (1.0, 0.82, 0.6), intensity: 3.5, range: 12.0),
    ),
    // What the host does with what it knows of the world (spec §4): how near a teammate shares
    // what they see (yards), how many path searches the host makes a step, and how long a
    // wanderer rests between walks (seconds, shortest and longest).
    world: (
        share_sight_within: 10.0,
        paths_per_step: 4,
        wander_pause: (3.0, 8.0),
    ),
)
