// Nightfall's rules. Sub-project 1 has the atmosphere (spec §10, §11); later sub-projects add their
// own settings here.
(
    // Every hero's level, matching Duskwood's creatures.
    hero_level: 30,
    atmosphere: (
        // Midnight.
        night_minute: 0,
        // Yards; the colour is sRGB 0..1, a dark blue-green.
        fog_start: 10.0,
        fog_end: 40.0,
        fog_color: (0.04, 0.07, 0.08),
        // How far the world is drawn, yards: past the fog, short of the stock 350.
        view_distance: 120.0,
        // A warm glow at each hero, linear RGB: a pool of light around the hero's feet, not a beacon.
        hero_light: (color: (1.0, 0.82, 0.6), intensity: 3.5, range: 12.0),
    ),
    // What the host does with what it knows of the world (spec §4): how near a teammate shares
    // what they see (yards), how many path searches the host makes a step, and how long a
    // wanderer rests between walks (seconds, shortest and longest).
    world: (
        share_sight_within: 10.0,
        paths_per_step: 4,
        wander_pause: (3.0, 8.0),
    ),
    // The senses (spec §5): how visible and how loud heroes are, and how enemies grow aware of
    // them. Every number is a starting value to playtest; one left out takes the value shown here.
    senses: (
        // Visibility 0..100 by stance, and what light multiplies it by (a lantern, standing in a
        // lit area, a fire spell's flash for `flash_for` seconds); never past 100.
        visibility: (run: 100.0, walk: 55.0, still: 35.0, sneak: 20.0, sneak_still: 8.0),
        lantern: 1.6,
        lit: 1.5,
        flash: 2.0,
        flash_for: 1.0,
        // An enemy notices a hero within notice_range × visibility / 100 × facing yards, never
        // past the fog: facing is 1 in its front cone (degrees; a sentry's is wider), `behind` in
        // its rear cone, `side` between.
        notice_range: 35.0,
        cone: 120.0,
        sentry_cone: 180.0,
        behind_cone: 120.0,
        side: 0.6,
        behind: 0.3,
        // Footsteps: how far each carries by stance (yards), one every `every` seconds of moving.
        steps: (run: 12.0, walk: 4.0, sneak: 0.0, every: 0.5),
        // How far other noises carry, yards: abilities by loudness, a hit or a death, opening a
        // chest or searching a body, digging a grave, ravens taking off, a second of extracting.
        loudness: (quiet: 8.0, normal: 20.0, loud: 40.0, hit: 15.0, open: 15.0, dig: 30.0,
                   ravens: 40.0, extract: 25.0),
        // Through a wall (no line of sight) a noise carries this share of its radius.
        walls: 0.5,
        // The rings by the player frame show the loudest noise of the last this-many seconds.
        noise_memory: 1.0,
        // Suspicion 0..100 of each hero: sight fills it by fill × (1 − distance / notice range) a
        // second (at least fill_min), a noise adds `noise`, neither drains `drain` a second. From
        // `suspicious` an enemy turns to look ("?"), from `check` it goes to look, at `alert` it
        // is alerted ("!") and shouts to allies within `shout` yards. Out of sight `lose_after`
        // seconds, it searches where it last saw its hero for `search_for` seconds.
        awareness: (fill: 60.0, fill_min: 10.0, noise: 35.0, drain: 10.0, suspicious: 40.0,
                    check: 60.0, alert: 100.0, shout: 15.0, lose_after: 5.0, search_for: 15.0),
        // An alerted enemy closes to this many yards of its hero.
        chase_reach: 2.0,
        // The first hit on an enemy not alerted to its attacker is multiplied by this.
        ambush: 1.5,
        // A stealthed hero moves at this share of their speed.
        stealth_speed: 0.7,
        // The heartbeat plays while an enemy alerted to you is this near, yards.
        heartbeat_within: 20.0,
        // The night grade's vignette (strength, inner edge from the centre; 0..1) at visibility
        // 100 and at 0: it tightens as the hero hides.
        vignette_seen: (0.45, 0.35),
        vignette_hidden: (0.85, 0.1),
    ),
    // The fight (spec §6, §8.1). A slowed cast moves at cast_move_speed, after speed_grace seconds
    // at full speed (while the slow reaches a joined client); a cast breaks past cast_slack yards
    // beyond that. Every range has `reach` yards (the target's size) added; `front` is degrees
    // either side of straight ahead. The dodge: charges, seconds each takes to come back, seconds
    // in which telegraphed blows miss, yards the hop goes. A hero is in combat while an enemy is
    // after them and combat_linger seconds after a blow; out of it, `regen` gives health and mana a
    // second (eating and drinking do the rest). Falling: downed_for seconds to be revived by a
    // teammate within revive_reach for revive_for seconds, getting up with revive_health of their
    // health; downed heroes crawl at crawl_speed.
    combat: (
        cast_move_speed: 0.5,
        cast_slack: 0.5,
        speed_grace: 0.3,
        reach: 1.5,
        front: 90.0,
        crit_chance: 0.05,
        crit_times: 1.5,
        dodge: (charges: 2, recharge: 8.0, immune: 0.3, distance: 6.0),
        combat_linger: 5.0,
        regen: (0.0, 0.0),
        downed_for: 45.0,
        revive_for: 5.0,
        revive_reach: 3.0,
        revive_health: 0.3,
        crawl_speed: 0.3,
        sheep_speed: 1.0,
        combo_max: 5,
        max_drinks: 20,
    ),
    // The run (spec §8, §11). death_loss: everything, everything_one_recovery or found_only.
    // Past weight_free a hero slows and steps louder, linearly, to weight_slow_floor of normal
    // speed and weight_noise_max times the footstep radius at weight_full; never stuck.
    // free_meal: Eat and Drink heals with no food (a drink still needed for mana).
    run: (
        death_loss: everything_one_recovery,
        safe_slots: 2,
        backpack_slots: 16,
        stash_slots: 60,
        weight_free: 20.0,
        weight_full: 60.0,
        weight_slow_floor: 0.7,
        weight_noise_max: 1.5,
        extract_for: 10.0,
        cart_opens_at: 1080.0,
        reach: 3.0,
        search_body: 1.5,
        noise_every: 2.0,
        container_slots: 16,
        potion_cooldown: 30.0,
        free_meal: false,
        conjured_drink: "conjured_water",
    ),
    // The night (spec §7.2, §7.3, §8.1). Each stage lands `at` seconds into the raid; its cue
    // sounds `warn` seconds before, with its line in the chat, and no timer shows anywhere. While
    // a stage lasts, the fog's distances are times `fog` and enemies' notice range times
    // `notice`; `hunt` sends the hunters toward the loudest noise of the last hunt.memory
    // seconds. A raid rolls one weather by weight (rain is the engine's own, `sound` its loop
    // kit), its exits (each not late is shut at `shut`, opens late within late_window at
    // `late`; the late ones open within cart_jitter of cart_opens_at; one may close as the hunt
    // lands at hunt_close; at least open_least open), and monsters_out of monsters.ron's.
    // Newcomers wait until no hero is within arrive_unseen yards; Mor'Ladim is looked at within
    // look_cone degrees of a hero's facing. measure: every cue's sound and the ravens' look,
    // with `cargo run -p benilla-formats --example list_chain -- <word> wav` (or `m2`).
    night: (
        stages: [
            (key: "dusk", name: "Dusk", at: 0.0),
            (key: "howling", name: "The howling", at: 480.0, warn: 20.0,
             cue: Some(File("Sound\\Creature\\Worgen\\mWorgenAttackD.wav")),
            // measure: the data has no howl; the worgen's longest attack growl stands in (list_chain
            // worgen wav: mWorgenAttackA-D, death and wound only).
             line: Some("Somewhere in the woods, the worgen begin to howl.")),
            // measure: no bell, toll, gong or church sound is in the trimmed data (list_chain
            // found none), so this path is a name to drop a file at: the client logs a debug line
            // and the cue is silent, its line still shown.
            (key: "moonrise", name: "Moonrise", at: 840.0, warn: 20.0, fog: 0.75, notice: 1.2,
             cue: Some(File("Sound\\Doodad\\BellTollHuman.wav")),
             line: Some("A bell tolls in Darkshire. The moon is rising, and the mist with it.")),
            (key: "hunt", name: "The hunt", at: 1200.0, warn: 20.0, fog: 0.75, notice: 1.2, hunt: true,
             cue: Some(File("Sound\\Creature\\Worgen\\mWorgenAttackD.wav")),
             line: Some("The howls answer each other now. The packs are hunting.")),
            // measure: no abomination sound exists; FleshGolem is the closest heavy voice.
            (key: "stitches", name: "Stitches", at: 1560.0, warn: 30.0, fog: 0.75, notice: 1.2, hunt: true,
             cue: Some(File("Sound\\Creature\\FleshGolem\\FleshGolemAttackB.wav")),
             line: Some("Something heavy is walking the road from Raven Hill.")),
        ],
        weather: [
            (key: "clear", name: "Clear", weight: 5.0, fog_start: 10.0, fog_end: 40.0),
            (key: "mist", name: "Mist", weight: 3.0, fog_start: 4.0, fog_end: 28.0,
             fog_color: Some((0.10, 0.12, 0.13))),
            (key: "rain", name: "Rain", weight: 2.0, fog_start: 6.0, fog_end: 32.0, rain: 0.7,
             sound: 8534),
        ],
        exits: (shut: 0.15, late: 0.25, late_window: (900.0, 1320.0), cart_jitter: 120.0,
                hunt_close: 0.5, open_least: 2),
        monsters_out: (1, 3),
        arrive_unseen: 50.0,
        look_cone: 90.0,
        scent: (every: 2.0, lasts: 30.0, pick: 3.0),
        hunt: (every: 15.0, memory: 30.0, reach: 150.0, rest: 4.0),
        // measure: the data has no crow (StormCrow has no displays or sound files); the FelBat
        // model (display 14562, CreatureDisplayInfo) and the Mobat attack sound stand in.
        ravens: (odds: 0.7, run_within: 8.0, fight_within: 15.0, back_after: 120.0, clear: 20.0,
                 birds: 3, display: 14562, scale: 0.3,
                 cry: Some(File("Sound\\Creature\\Mobat\\MobatAttackA.wav"))),
    ),
)
