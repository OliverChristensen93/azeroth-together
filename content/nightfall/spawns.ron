// Where Nightfall's enemies stand and walk (spec §7.1): a sentry holds a post, a sleeper lies at
// one (it hears but does not see until alerted), a patrol walks its route round and round,
// wanderers roam an area. Points are WoW (x, y) yards; `facing` is degrees
// from north toward west; `z` (optional) picks the floor near that height, for an upper storey.
//
// Every group sits near the first entry for now, so a run meets them at once. Each is marked
// `measure:` with the place it belongs; move it there once measured in the game
// (`NIGHTFALL_TRACE_POS=1` logs where the hero stands, and
// `cargo run -p nightfall-bake --example buildings -- <x> <y> <radius>` lists the buildings
// around a point).
[
    // measure: Raven Hill cemetery's gate.
    (place: "Near the entry: a sentry", kind: "skeletal_warrior",
     behaviour: Sentry(at: (-10040.0, -800.0), facing: 180.0)),
    // measure: the road past Brightwood Grove.
    (place: "Near the entry: a patrol", kind: "nightbane_worgen",
     behaviour: Patrol(route: [(-10035.0, -775.0), (-10035.0, -815.0), (-10070.0, -815.0),
                               (-10070.0, -775.0)], pause: 2.0)),
    // measure: Twilight Grove's webs.
    (place: "Near the entry: spiders", kind: "venom_web_spider", count: 3,
     behaviour: Wander(center: (-10085.0, -790.0), radius: 18.0)),
    // measure: the Rotting Orchard.
    (place: "Near the entry: ravagers", kind: "black_ravager", count: 2,
     behaviour: Wander(center: (-10020.0, -760.0), radius: 20.0)),
    // measure: Raven Hill's crypt, where the dead lie until woken.
    (place: "Near the entry: a sleeper", kind: "fetid_corpse",
     behaviour: Sleeper(at: (-10062.0, -805.0), facing: 45.0)),
    // measure: a shadow weaver at Raven Hill's chapel door: a caster that fights from range.
    (place: "Near the entry: a caster", kind: "nightbane_shadow_weaver",
     behaviour: Sentry(at: (-10010.0, -830.0), facing: 0.0)),
    // measure: Fenros's den by the Brightwood road.
    (place: "Near the entry: Fenros", kind: "fenros",
     behaviour: Sentry(at: (-10100.0, -840.0), facing: 45.0)),
    // measure: Naraxis's lair in Twilight Grove.
    (place: "Near the entry: Naraxis", kind: "naraxis",
     behaviour: Wander(center: (-10110.0, -760.0), radius: 8.0)),
    // measure: Brightwood Grove, where the Night Watch's contract sends heroes. A worgen pack in
    // the contract's circle (contracts.ron "brightwood_pack"), over baked, walkable ground.
    (place: "Brightwood Grove: a worgen pack", kind: "nightbane_worgen", count: 6,
     behaviour: Wander(center: (-10300.0, -1240.0), radius: 25.0)),
    // The howling (spec §7.2) brings more wanderers, at the pack's place. measure: (-10300, -1240)
    // is where a whole pack finds ground to walk on in the real bake (the old centre
    // (-10280, -1250) left a worgen with none: `cargo test --release -p nightfall-bake --test
    // roads` plays two minutes on the bake and fails on that warning).
    (place: "Brightwood Grove: the howling", kind: "nightbane_worgen", count: 3,
     stage: Some("howling"), behaviour: Wander(center: (-10300.0, -1240.0), radius: 30.0)),
    (place: "Near the entry: the howling", kind: "nightbane_worgen", count: 2,
     stage: Some("howling"), behaviour: Wander(center: (-10090.0, -760.0), radius: 20.0)),
]
